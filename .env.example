# Адрес, по которому открывают систему (нужен для OAuth и ссылок)
APP_URL=http://localhost:3000

# PostgreSQL. В Yandex Managed PostgreSQL включите DATABASE_SSL=true
DATABASE_URL=postgres://fieldops:fieldops@localhost:54329/fieldops
DATABASE_SSL=false
# Корневой сертификат Яндекса (содержимое файла root.crt), если DATABASE_SSL=true
DATABASE_CA_CERT=

# Хранилище файлов: local (папка на диске, для разработки) или s3 (Yandex Object Storage)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/files
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Вход. Включается тот провайдер, для которого заданы ключи (можно оба).
# Google: console.cloud.google.com → OAuth client (Web). Redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Яндекс ID: oauth.yandex.ru. Redirect URI: {APP_URL}/api/auth/callback/yandex
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Разрешённые домены почты через запятую (пусто — любой домен, но доступ всё равно только по списку сотрудников)
ALLOWED_EMAIL_DOMAINS=

# Вход без OAuth по выбору сотрудника — ТОЛЬКО для локальной разработки
DEV_LOGIN=false

# Первый руководитель, создаётся командой npm run db:seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=

# Часовой пояс по умолчанию (если браузер не сообщил свой)
DEFAULT_TIMEZONE=Asia/Almaty
